# ── GCP Core ─────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-project-id
GCP_REGION=asia-south1

# ── GCS ──────────────────────────────────────────────────────────────────────
GCS_BUCKET_NAME=memvault-photos-your-project-id
GCS_SIGNED_URL_TTL_SECONDS=900

# ── Pub/Sub ───────────────────────────────────────────────────────────────────
PUBSUB_UPLOAD_TOPIC=photo.uploaded
PUBSUB_ENHANCE_TOPIC=photo.enhanced
PUBSUB_FAILED_TOPIC=photo.failed
PUBSUB_EMULATOR_HOST=                  # e.g. localhost:8085 for local dev

# ── Firestore ─────────────────────────────────────────────────────────────────
FIRESTORE_PROJECT_ID=your-project-id
FIRESTORE_DATABASE=(default)
FIRESTORE_EMULATOR_HOST=               # e.g. localhost:8080 for local dev

# ── Firebase Auth ─────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-project-id
# Path to Firebase Admin SDK service account (local dev only — use Workload Identity in GKE)
FIREBASE_ADMIN_SDK_JSON=

# ── Vertex AI ─────────────────────────────────────────────────────────────────
VERTEX_AI_ENDPOINT=projects/YOUR_PROJECT/locations/asia-south1/endpoints/YOUR_ENDPOINT_ID
VERTEX_AI_LOCATION=asia-south1

# ── Enhancement Service ───────────────────────────────────────────────────────
ENABLE_SKIN_TONE_CORRECTION=true
ENABLE_BACKGROUND_REMOVAL=false        # album-level override available in Firestore
THUMB_SIZES=256,1024

# ── B2B API ───────────────────────────────────────────────────────────────────
API_GATEWAY_URL=https://api.memvault.example.com
# API keys are stored in Secret Manager, not here

# ── BigQuery Analytics ────────────────────────────────────────────────────────
BQ_DATASET=analytics
BQ_EVENTS_TABLE=events_raw
BQ_LOCATION=asia-south1

# ── Service URLs (local Docker Compose) ──────────────────────────────────────
UPLOAD_SERVICE_URL=http://localhost:8001
DELIVERY_SERVICE_URL=http://localhost:8002
AUTH_SERVICE_URL=http://localhost:8003
API_SERVICE_URL=http://localhost:8004

# ── Studio Portal ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_UPLOAD_SERVICE_URL=http://localhost:8001
NEXT_PUBLIC_DELIVERY_SERVICE_URL=http://localhost:8002
